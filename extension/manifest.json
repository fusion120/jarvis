{
  "manifest_version": 3,
  "name": "Jarvis Agent",
  "version": "1.2",
  "description": "Jarvis can see and control your browser. Say the word, Sir.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "tabCapture",
    "tabGroups",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jarvis Agent"
  }
}
